# Keep source/config files as LF so they work unchanged on Ubuntu.

.gitattributes text eol=lf
.gitignore text eol=lf

*.xml text eol=lf
*.launch text eol=lf
*.xacro text eol=lf
*.urdf text eol=lf
*.world text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.rviz text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.cmake text eol=lf
*.txt text eol=lf

# Our own markdown docs (scoped so existing unrelated docs are untouched).
README.md text eol=lf
docs/*.md text eol=lf

# Binary assets: never normalize line endings.
*.png binary
*.jpg binary
*.jpeg binary
*.pgm binary
*.stl binary
*.dae binary
*.so binary
