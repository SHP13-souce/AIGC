<?xml version="1.0" encoding="utf-8"?>
<COLLADA xmlns="http://www.collada.org/2005/11/COLLADASchema" version="1.4.1">
  <asset>
    <unit name="meter" meter="1"/>
    <up_axis>Z_UP</up_axis>
  </asset>
  <library_images>
    <image id="marker_1_img" name="marker_1_img">
      <init_from>../materials/textures/marker_1.png</init_from>
    </image>
  </library_images>
  <library_materials>
    <material id="marker_1_mat" name="marker_1_mat">
      <instance_effect url="#marker_1_fx"/>
    </material>
  </library_materials>
  <library_effects>
    <effect id="marker_1_fx" name="marker_1_fx">
      <profile_COMMON>
        <technique sid="common">
          <lambert>
            <emission><color>1 1 1 1</color></emission>
            <ambient><color>1 1 1 1</color></ambient>
            <diffuse>
              <texture texture="marker_1_img" texcoord="UVSET0"/>
            </diffuse>
          </lambert>
        </technique>
      </profile_COMMON>
    </effect>
  </library_effects>
  <library_geometries>
    <geometry id="marker_1_geo" name="marker_1_geo">
      <mesh>
        <source id="marker_1_pos" name="marker_1_pos">
          <float_array id="marker_1_pos_arr" count="12">-0.045 -0.045 0 0.045 -0.045 0 -0.045 0.045 0 0.045 0.045 0</float_array>
          <technique_common>
            <accessor source="#marker_1_pos_arr" count="4" stride="3">
              <param name="X" type="float"/>
              <param name="Y" type="float"/>
              <param name="Z" type="float"/>
            </accessor>
          </technique_common>
        </source>
        <source id="marker_1_uv" name="marker_1_uv">
          <float_array id="marker_1_uv_arr" count="8">0 0 1 0 0 1 1 1</float_array>
          <technique_common>
            <accessor source="#marker_1_uv_arr" count="4" stride="2">
              <param name="S" type="float"/>
              <param name="T" type="float"/>
            </accessor>
          </technique_common>
        </source>
        <vertices id="marker_1_verts">
          <input semantic="POSITION" source="#marker_1_pos"/>
        </vertices>
        <triangles material="marker_1_mat" count="2">
          <input semantic="VERTEX" source="#marker_1_verts" offset="0"/>
          <input semantic="TEXCOORD" source="#marker_1_uv" offset="1" set="0"/>
          <p>0 0 1 1 2 2 2 2 1 1 3 3</p>
        </triangles>
      </mesh>
    </geometry>
  </library_geometries>
  <library_visual_scenes>
    <visual_scene id="Scene" name="Scene">
      <node id="marker_1_node" name="marker_1_node">
        <instance_geometry url="#marker_1_geo">
          <bind_material>
            <technique_common>
              <instance_material symbol="marker_1_mat" target="#marker_1_mat"/>
            </technique_common>
          </bind_material>
        </instance_geometry>
      </node>
    </visual_scene>
  </library_visual_scenes>
  <scene>
    <instance_visual_scene url="#Scene"/>
  </scene>
</COLLADA>
