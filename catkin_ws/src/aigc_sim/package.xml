<?xml version="1.0"?>
<package format="2">
  <name>aigc_sim</name>
  <version>0.0.1</version>
  <description>Simulation launch files, test world and RViz configuration for the AIGC unmanned vehicle challenge.</description>
  <maintainer email="aigc@example.com">AIGC Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>aigc_description</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>gazebo_plugins</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz</exec_depend>

  <export>
    <!-- model://aigc_sim/... resolves against GAZEBO_MODEL_PATH, which must
         point at the directory *containing* aigc_sim. In both the source
         (${prefix} = .../src/aigc_sim) and install (${prefix} =
         .../share/aigc_sim) layouts, ${prefix}/.. + aigc_sim/meshes/... lands
         on the installed mesh files. -->
    <gazebo_ros gazebo_model_path="${prefix}/.." />
    <!-- Media path stays for the DAE relative texture/material references
         (../materials/textures/*.png). -->
    <gazebo_ros gazebo_media_path="${prefix}" />
  </export>
</package>
