<?xml version="1.0"?>
<sdf version="1.6">
  <world name="aigc_test_world">

    <!-- Inline directional light (avoids online model download). -->
    <light name="sun" type="directional">
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.7 0.7 0.7 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0 0 -1</direction>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- Inline ground plane (top surface at z = 0). -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>20 20 0.1</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>20 20 0.1</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>0 0 -0.05 0 0 0</pose>
    </model>

    <!--
      Walls: inner clear area 3.6 m x 3.6 m.
      Wall thickness 0.10 m, wall height 0.30 m.
      Inner faces at +/-1.8 m, outer faces at +/-1.9 m.
    -->
    <model name="wall_front">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.10 3.80 0.30</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.10 3.80 0.30</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.5 0.2 1</ambient>
            <diffuse>0.8 0.6 0.3 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>1.85 0 0.15 0 0 0</pose>
    </model>

    <model name="wall_back">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.10 3.80 0.30</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.10 3.80 0.30</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.5 0.2 1</ambient>
            <diffuse>0.8 0.6 0.3 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>-1.85 0 0.15 0 0 0</pose>
    </model>

    <model name="wall_left">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>3.80 0.10 0.30</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>3.80 0.10 0.30</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.5 0.2 1</ambient>
            <diffuse>0.8 0.6 0.3 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>0 1.85 0.15 0 0 0</pose>
    </model>

    <model name="wall_right">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>3.80 0.10 0.30</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>3.80 0.10 0.30</size>
            </box>
          </geometry>
          <material>
            <ambient>0.7 0.5 0.2 1</ambient>
            <diffuse>0.8 0.6 0.3 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>0 -1.85 0.15 0 0 0</pose>
    </model>

    <!-- Colored test object placed in front of the robot spawn point (0, 0). -->
    <model name="test_object">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.12 0.12 0.30</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.12 0.12 0.30</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.1 0.1 1</ambient>
            <diffuse>0.9 0.1 0.1 1</diffuse>
          </material>
        </visual>
      </link>
      <pose>0.8 0 0.15 0 0 0</pose>
    </model>

    <!--
      AR test target boards (round 4). These are TEST targets, not the
      official competition targets. Each board is a white 0.20 m x 0.20 m x
      0.02 m slab carrying a 0.09 m x 0.09 m marker texture (marker_size =
      9 cm). The model-level pose stays axis-aligned (zero rotation) so the
      existing box map generator keeps working; the marker's orientation is
      applied inside its <visual>.
    -->
    <model name="ar_target_0">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.20 0.02 0.20</size>
            </box>
          </geometry>
        </collision>
        <visual name="backboard">
          <geometry>
            <box>
              <size>0.20 0.02 0.20</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
        <visual name="marker">
          <pose>0 -0.011 0 1.57079632679 0 0</pose>
          <geometry>
            <mesh>
              <uri>model://aigc_sim/meshes/marker_0.dae</uri>
            </mesh>
          </geometry>
        </visual>
      </link>
      <pose>1.2 0.65 0.15 0 0 0</pose>
    </model>

    <model name="ar_target_1">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.02 0.20 0.20</size>
            </box>
          </geometry>
        </collision>
        <visual name="backboard">
          <geometry>
            <box>
              <size>0.02 0.20 0.20</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
        <visual name="marker">
          <pose>0.011 0 0 1.57079632679 0 1.57079632679</pose>
          <geometry>
            <mesh>
              <uri>model://aigc_sim/meshes/marker_1.dae</uri>
            </mesh>
          </geometry>
        </visual>
      </link>
      <pose>0.55 1.0 0.15 0 0 0</pose>
    </model>

    <model name="ar_target_2">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.20 0.02 0.20</size>
            </box>
          </geometry>
        </collision>
        <visual name="backboard">
          <geometry>
            <box>
              <size>0.20 0.02 0.20</size>
            </box>
          </geometry>
          <material>
            <ambient>0.9 0.9 0.9 1</ambient>
            <diffuse>0.9 0.9 0.9 1</diffuse>
          </material>
        </visual>
        <visual name="marker">
          <pose>0 0.011 0 1.57079632679 0 3.14159265359</pose>
          <geometry>
            <mesh>
              <uri>model://aigc_sim/meshes/marker_2.dae</uri>
            </mesh>
          </geometry>
        </visual>
      </link>
      <pose>-1.0 0.35 0.15 0 0 0</pose>
    </model>

  </world>
</sdf>
