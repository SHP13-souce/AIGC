<?xml version="1.0"?>
<package format="2">
  <name>aigc_navigation</name>
  <version>0.0.1</version>
  <description>
    Single-goal and sequential waypoint autonomous navigation (AMCL + move_base
    + Navfn + DWA) for the AIGC unmanned vehicle challenge.
  </description>
  <maintainer email="aigc@example.com">AIGC Team</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>aigc_sim</exec_depend>
  <exec_depend>aigc_description</exec_depend>
  <exec_depend>amcl</exec_depend>
  <exec_depend>map_server</exec_depend>
  <exec_depend>move_base</exec_depend>
  <exec_depend>navfn</exec_depend>
  <exec_depend>dwa_local_planner</exec_depend>
  <exec_depend>clear_costmap_recovery</exec_depend>
  <exec_depend>rotate_recovery</exec_depend>
  <exec_depend>costmap_2d</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>actionlib</exec_depend>
  <exec_depend>actionlib_msgs</exec_depend>
  <exec_depend>move_base_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>roslib</exec_depend>
  <exec_depend>rosservice</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>ar_track_alvar</exec_depend>
  <exec_depend>ar_track_alvar_msgs</exec_depend>
  <exec_depend>rviz</exec_depend>

  <export>
  </export>
</package>
